                  "pm.test(\"Токен присутствует\", function() { const j=pm.response.json(); pm.expect(j.token).to.be.a('string').and.not.empty; });",
                  "if(pm.response.code===200){ const j=pm.response.json(); if(j.token){pm.environment.set('token',j.token);} }"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"password123\"\r\n}",
              "options": {
